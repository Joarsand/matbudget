# Configuration documentation. Set these as environment variables in the service;
# the dependency-free server does not automatically load .env files.
HOST=127.0.0.1
PORT=8787
AI_ENABLED=0
AWS_REGION=eu-north-1
BEDROCK_MODEL_ID=eu.amazon.nova-micro-v1:0
AI_DAILY_LIMIT=20
AI_STATE_FILE=/var/lib/matbudget/ai-usage.json
# Generate a random code with at least 16 characters. Never commit the real code.
AI_ACCESS_CODE=
# Only for Windows local development using the installed Ubuntu AWS CLI:
BEDROCK_USE_WSL=0
